# ==============================================================================
# PRODUCTION / DOCKER COMPOSE CONFIGURATION
# Copy this file to .env and fill in the actual values.
# Do NOT commit your actual .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Settings (Build Time)
# ------------------------------------------------------------------------------
# The publishable key is safe to expose to the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------------------
# Backend Settings (Runtime)
# ------------------------------------------------------------------------------
# Clerk secret key is required for backend authentication validation.
# NEVER expose this to the frontend.
CLERK_SECRET_KEY=sk_test_...

# Clerk publishable key must be provided to the backend as well.
CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY}

# Cloudinary credentials for attachment uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Note: MONGODB_URI and REDIS_URL are automatically configured in docker-compose.yml
# using the internal Docker network hostnames. You do not need to set them here
# unless you are running outside of Docker.
